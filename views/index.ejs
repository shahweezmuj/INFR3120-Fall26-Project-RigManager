
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title><%= title %> | RigManager</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

<%- include("partials/nav") %>

<main class="container py-4">

    <!-- DASHBOARD HERO -->
    <section class="hero p-4 p-md-5 mb-4">

        <div class="row align-items-center g-4">

            <div class="col-lg-8">

                <div class="eyebrow">
                    PC INVENTORY & BUILD MANAGEMENT
                </div>

                <h1 class="display-5 fw-bold mt-2">
                    Build smarter. Track every part.
                </h1>

                <p class="lead text-secondary">
                    Organize PC components, plan complete builds,
                    estimate resale profit, and prepare marketplace listings.
                </p>

                <a class="btn btn-orange btn-lg me-2" href="#add-item">
                    + Add inventory item
                </a>

                <a class="btn btn-outline-light btn-lg" href="/builds/new">
                    Create a PC build
                </a>

            </div>

            <div class="col-lg-4 text-center">

                <img
                    class="hero-logo"
                    src="/images/rigmanager-logo.svg"
                    alt="RigManager logo"
                >

            </div>

        </div>

    </section>


    <!-- SUCCESS / ERROR MESSAGE -->
    <% if (message) { %>

        <div class="alert alert-info">
            <%= message %>
        </div>

    <% } %>


    <!-- DASHBOARD STATISTICS -->
    <section class="row g-3 mb-4">

        <div class="col-md-4">

            <div class="stat-card">

                <span>Total units in stock</span>

                <strong>
                    <%= totalUnits %>
                </strong>

            </div>

        </div>

        <div class="col-md-4">

            <div class="stat-card">

                <span>Inventory purchase value</span>

                <strong>
                    $<%= inventoryValue %>
                </strong>

            </div>

        </div>

        <div class="col-md-4">

            <div class="stat-card">

                <span>Estimated / actual build profit</span>

                <strong>
                    $<%= estimatedProfit %>
                </strong>

            </div>

        </div>

    </section>


    <!-- ADD INVENTORY -->
    <section class="panel mb-4" id="add-item">

        <div class="section-heading">

            <div>

                <div class="eyebrow">
                    INVENTORY
                </div>

                <h2>Add a component</h2>

            </div>

        </div>


        <form action="/inventory/add" method="POST" class="row g-3">

            <div class="col-md-4">

                <label class="form-label">
                    Component name
                </label>

                <input
                    class="form-control"
                    name="name"
                    placeholder="e.g. Ryzen 5 5600"
                    required
                >

            </div>


            <div class="col-md-2">

                <label class="form-label">
                    Category
                </label>

                <select class="form-select" name="category">

                    <% [
                        "CPU",
                        "GPU",
                        "Motherboard",
                        "RAM",
                        "Storage",
                        "PSU",
                        "Case",
                        "Cooler",
                        "Other"
                    ].forEach(category => { %>

                        <option value="<%= category %>">
                            <%= category %>
                        </option>

                    <% }) %>

                </select>

            </div>


            <div class="col-md-2">

                <label class="form-label">
                    Purchase cost (CAD)
                </label>

                <input
                    class="form-control"
                    name="cost"
                    type="number"
                    min="0"
                    step="0.01"
                    required
                >

            </div>


            <div class="col-md-2">

                <label class="form-label">
                    Quantity
                </label>

                <input
                    class="form-control"
                    name="quantity"
                    type="number"
                    min="1"
                    step="1"
                    value="1"
                    required
                >

            </div>


            <div class="col-md-2">

                <label class="form-label">
                    Condition
                </label>

                <select class="form-select" name="condition">

                    <option>Used</option>
                    <option>New</option>
                    <option>Open box</option>
                    <option>For parts</option>

                </select>

            </div>


            <div class="col-12">

                <button class="btn btn-orange">
                    Save inventory item
                </button>

            </div>

        </form>

    </section>


    <!-- CURRENT INVENTORY -->
    <section class="panel">

        <div class="section-heading">

            <div>

                <div class="eyebrow">
                    YOUR PARTS
                </div>

                <h2>Current inventory</h2>

            </div>

            <span class="text-secondary small">
                <%= items.length %> item types
            </span>

        </div>


        <% if (!items.length) { %>

            <p class="text-secondary">
                Your inventory is empty. Add your first component above.
            </p>

        <% } else { %>

            <div class="table-responsive">

                <table class="table align-middle">

                    <thead>

                        <tr>
                            <th>Component</th>
                            <th>Category</th>
                            <th>Condition</th>
                            <th>Unit cost</th>
                            <th>Qty</th>
                            <th>Stock value</th>
                            <th></th>
                        </tr>

                    </thead>


                    <tbody>

                        <% items.forEach(item => { %>

                            <tr>

                                <td class="fw-semibold">
                                    <%= item.name %>
                                </td>

                                <td>

                                    <span class="category-pill">
                                        <%= item.category %>
                                    </span>

                                </td>

                                <td>
                                    <%= item.condition %>
                                </td>

                                <td>
                                    $<%= Number(item.cost).toFixed(2) %>
                                </td>

                                <td>
                                    <%= item.quantity %>
                                </td>

                                <td>
                                    $<%= (
                                        Number(item.cost) *
                                        Number(item.quantity)
                                    ).toFixed(2) %>
                                </td>

                                <td>

                                    <form
                                        action="/inventory/<%= item.id %>/delete"
                                        method="POST"
                                        onsubmit="return confirm('Remove this inventory item?')"
                                    >

                                        <button class="btn btn-sm btn-outline-danger">
                                            Remove
                                        </button>

                                    </form>

                                </td>

                            </tr>

                        <% }) %>

                    </tbody>

                </table>

            </div>

        <% } %>

    </section>


    <!-- BUILD MANAGER -->
    <section class="panel mt-4">

        <div class="section-heading">

            <div>

                <div class="eyebrow">
                    PC MANAGEMENT
                </div>

                <h2>Build Manager</h2>

                <p class="text-secondary mb-0">
                    Track your builds, sales, returns and actual profits.
                </p>

            </div>

            <a href="/builds/new" class="btn btn-orange">
                + New Build
            </a>

        </div>


        <% if (!builds.length) { %>

            <p class="text-secondary">
                No builds available yet. Create your first PC build to get started.
            </p>

        <% } else { %>


            <!-- BUILD MANAGER TABLE -->
            <div class="table-responsive">

                <table class="table align-middle">

                    <thead>

                        <tr>

                            <th>PC Build</th>
                            <th>Build Cost</th>
                            <th>Expected Price</th>
                            <th>Status</th>
                            <th>Actual Sale Price</th>
                            <th>Profit</th>
                            <th>Manage</th>

                        </tr>

                    </thead>


                    <tbody>

                        <% builds.forEach(build => { %>

                            <tr>

                                <!-- BUILD NAME -->
                                <td>

                                    <strong>
                                        <%= build.name %>
                                    </strong>

                                    <br>

                                    <a
                                        href="/builds/<%= build.id %>"
                                        class="small"
                                    >
                                        View listing
                                    </a>

                                </td>


                                <!-- BUILD COST -->
                                <td>
                                    $<%= Number(build.cost).toFixed(2) %>
                                </td>


                                <!-- EXPECTED PRICE -->
                                <td>
                                    $<%= Number(build.askingPrice).toFixed(2) %>
                                </td>


                                <!-- BUILD STATUS -->
                                <td>

                                    <% const status = build.status || "In Stock"; %>

                                    <% if (status === "Sold") { %>

                                        <span class="badge bg-success">
                                            Sold
                                        </span>

                                    <% } else if (status === "Returned") { %>

                                        <span class="badge bg-warning text-dark">
                                            Returned
                                        </span>

                                    <% } else { %>

                                        <span class="badge bg-info text-dark">
                                            In Stock
                                        </span>

                                    <% } %>

                                </td>


                                <!-- ACTUAL SALE PRICE -->
                                <td>

                                    <% if (status === "Sold" && build.actualSalePrice !== null && build.actualSalePrice !== undefined) { %>

                                        $<%= Number(build.actualSalePrice).toFixed(2) %>

                                    <% } else { %>

                                        -

                                    <% } %>

                                </td>


                                <!-- PROFIT -->
                                <td>

                                    <% if (status === "Sold") { %>

                                        <span class="<%= Number(build.actualProfit) >= 0 ? 'profit' : 'loss' %>">

                                            $<%= Number(build.actualProfit || 0).toFixed(2) %>

                                        </span>

                                    <% } else if (status === "Returned") { %>

                                        -

                                    <% } else { %>

                                        <span class="<%= Number(build.profit) >= 0 ? 'profit' : 'loss' %>">

                                            $<%= Number(build.profit).toFixed(2) %>

                                        </span>

                                    <% } %>

                                </td>


                                <!-- MANAGE BUILD -->
                                <td>

                                    <div style="min-width: 180px;">

                                        <form
                                            action="/builds/<%= build.id %>/update"
                                            method="POST"
                                            class="d-flex flex-column gap-2"
                                        >

                                            <select
                                                name="status"
                                                class="form-select form-select-sm"
                                            >

                                                <option
                                                    value="In Stock"
                                                    <%= status === "In Stock" ? "selected" : "" %>
                                                >
                                                    In Stock
                                                </option>

                                                <option
                                                    value="Sold"
                                                    <%= status === "Sold" ? "selected" : "" %>
                                                >
                                                    Sold
                                                </option>

                                                <option
                                                    value="Returned"
                                                    <%= status === "Returned" ? "selected" : "" %>
                                                >
                                                    Returned
                                                </option>

                                            </select>


                                            <input
                                                type="number"
                                                name="actualSalePrice"
                                                class="form-control form-control-sm"
                                                placeholder="Actual sale price"
                                                min="0"
                                                step="0.01"
                                                value="<%= build.actualSalePrice ?? '' %>"
                                            >


                                            <button
                                                type="submit"
                                                class="btn btn-sm btn-orange"
                                            >
                                                Save Changes
                                            </button>

                                        </form>


                                        <!-- DELETE BUILD -->
                                        <form
                                            action="/builds/<%= build.id %>/delete"
                                            method="POST"
                                            class="mt-2"
                                            onsubmit="return confirm('Are you sure you want to delete this build?')"
                                        >

                                            <button
                                                type="submit"
                                                class="btn btn-sm btn-outline-danger w-100"
                                            >
                                                Delete Build
                                            </button>

                                        </form>

                                    </div>

                                </td>

                            </tr>

                        <% }) %>

                    </tbody>

                </table>

            </div>

        <% } %>

    </section>

</main>

<%- include("partials/footer") %>

</body>
</html>
