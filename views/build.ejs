<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Build Planner | RigManager</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link rel="stylesheet" href="/css/style.css"></head><body>
<%- include("partials/nav") %><main class="container py-4"><a href="/" class="back-link">← Back to inventory</a><div class="eyebrow mt-3">PC BUILD PLANNER</div><h1>Put together a PC</h1><p class="text-secondary mb-4">Choose parts from your inventory and enter an estimated selling price.</p>
<% if (error) { %><div class="alert alert-warning"><%= error %></div><% } %>
<form method="POST" action="/builds" class="panel"><div class="row g-3">
<div class="col-md-6"><label class="form-label">Build name</label><input name="buildName" class="form-control" placeholder="1080p Gaming PC" required></div>
<div class="col-md-6"><label class="form-label">Estimated selling price (CAD)</label><input name="askingPrice" type="number" min="0" step="0.01" class="form-control" placeholder="850" required></div>
<% categories.forEach(category => { const available = items.filter(item => item.category === category && item.quantity > 0); %>
<div class="col-md-6"><label class="form-label"><%= category %></label><select class="form-select" name="<%= category %>"><option value="">-- Don't select --</option><% available.forEach(item => { %><option value="<%= item.id %>"><%= item.name %> · $<%= Number(item.cost).toFixed(2) %> · Qty <%= item.quantity %></option><% }) %></select></div><% }) %>
</div><div class="mt-4"><button class="btn btn-orange btn-lg">Calculate and save build</button></div><p class="small text-secondary mt-3 mb-0">Saving a build reduces the stock quantity of each selected component by one.</p></form></main><%- include("partials/footer") %></body></html>
