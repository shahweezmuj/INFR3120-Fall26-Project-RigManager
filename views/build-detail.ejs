<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title><%= title %> | RigManager</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link rel="stylesheet" href="/css/style.css"></head><body>
<%- include("partials/nav") %><main class="container py-4"><a href="/" class="back-link">← Back to dashboard</a><div class="eyebrow mt-3">SAVED BUILD</div><h1><%= build.name %></h1>
<div class="row g-3 my-3">
<div class="col-md-3"><div class="stat-card"><span>Build cost</span><strong>$<%= build.cost.toFixed(2) %></strong></div></div>
<div class="col-md-3"><div class="stat-card"><span>Estimated sale price</span><strong>$<%= build.askingPrice.toFixed(2) %></strong></div></div>
<div class="col-md-3"><div class="stat-card"><span>Estimated profit</span><strong class="<%= build.profit >= 0 ? 'profit' : 'loss' %>">$<%= build.profit.toFixed(2) %></strong></div></div>
<div class="col-md-3"><div class="stat-card"><span>Profit margin</span><strong><%= build.margin %>%</strong></div></div></div>
<section class="panel mb-4"><h2>Selected components</h2><ul class="list-group list-group-flush"><% build.parts.forEach(part => { %><li class="list-group-item bg-transparent text-light d-flex justify-content-between"><span><%= part.category %> — <%= part.name %></span><span>$<%= part.cost.toFixed(2) %></span></li><% }) %></ul></section>
<section class="panel"><div class="section-heading"><div><div class="eyebrow">MARKETPLACE COPY</div><h2>Generated listing description</h2></div><button class="btn btn-orange" type="button" onclick="copyListing()">Copy description</button></div>
<textarea id="listing" class="form-control listing-box" rows="12" readonly><%= listing %></textarea><div id="copyMessage" class="small text-secondary mt-2"></div></section></main><%- include("partials/footer") %>
<script>function copyListing(){navigator.clipboard.writeText(document.getElementById("listing").value).then(()=>{document.getElementById("copyMessage").textContent="Listing copied to clipboard.";}).catch(()=>{document.getElementById("copyMessage").textContent="Select and copy the text manually.";});}</script></body></html>
